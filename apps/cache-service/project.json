{
  "name": "cache-service",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/cache-service/src",
  "targets": {
    "serve": {
      "executor": "nx:run-commands",
      "continuous": true,
      "options": { "command": "node apps/cache-service/src/main.js", "cwd": "{workspaceRoot}" },
      "configurations": {
        "development": { "command": "nodemon apps/cache-service/src/main.js", "cwd": "{workspaceRoot}" }
      }
    }
  },
  "tags": ["type:service"]
}
