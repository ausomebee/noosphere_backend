{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "types": [
      "node",
      "express"
    ],
    "rootDir": "src",
    "tsBuildInfoFile": "dist/tsconfig.app.tsbuildinfo",
    "allowJs": true,          
    "checkJs": false,       
    "noEmit": false
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.js"
  ]
}