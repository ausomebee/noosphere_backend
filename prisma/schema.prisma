generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Module {
  ADMIN
  TENANT
  CLIENT
}

enum SubscriptionStatus {
  ACTIVE
  PAUSED
  PENDING
  CANCELLED
}

enum PlanType {
  ENTERPRISE
  STANDARD
}

enum InvoiceStatus {
  Paid
  Upcoming
  Due
  Overdue
}

enum incoiceBillingFrequency {
  Monthly
  Yearly
}

enum DomainType {
  SKILL_ACQUISITION
  BEHAVIOR_REDUCTION
}

model Admin {
  id                    String   @id @default(uuid())
  fullName              String
  email                 String   @unique
  phoneNumber           String   @unique
  roleId                String
  superAdmin            Boolean  @default(false)
  active                Boolean  @default(true)
  isDeleted             Boolean  @default(false)
  password              String?
  administratorPassword String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  authType              String?
  authQuestion          String?
  auth2FADone           Boolean  @default(false)

  roles          Role           @relation(fields: [roleId], references: [id])
  pipelines      Pipeline[]
  departments    Department[]
  PipelineItem   PipelineItem[]
  Tenant         Tenant[]
  logs           Logs[]
  BillingPlan    BillingPlan[]
  IssueComment   IssueComment[]
  assignedIssues Issue[]        @relation("AssignedAdmin")
  loggedIssues   Issue[]        @relation("LoggedByAdmin")
}

model Auth {
  id        String   @id @default(uuid())
  userId    String   @unique
  module    Module
  secret    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Department {
  id                String   @id @default(uuid())
  name              String
  module            Module
  createdByAdminId  String?
  createdByTenantId String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  description       String?
  access            Json

  roles           Role[]
  createdByAdmin  Admin?  @relation(fields: [createdByAdminId], references: [id])
  createdByTenant Tenant? @relation(fields: [createdByTenantId], references: [id])
}

model Role {
  id           String   @id @default(uuid())
  name         String
  description  String?
  departmentId String
  access       Json
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  admins      Admin[]
  department  Department    @relation(fields: [departmentId], references: [id])
  TenantStaff TenantStaff[]
}

model Tenant {
  id               String   @id @default(uuid())
  email            String   @unique
  phoneNumber      String   @unique
  active           Boolean  @default(true)
  isDeleted        Boolean  @default(false)
  companyName      String
  contactPerson    String
  companySize      String
  organizationType String
  location         Json
  leadSource       String
  stage            String   @default("UNVERIFIED")
  website          String?
  practiceNPI      String?
  createdBy        String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  pipelineItems              PipelineItem[]
  clientLinks                ClientTenant[]
  pipelines                  Pipeline[]
  departments                Department[]
  TenantStaff                TenantStaff[]
  BillingMetadata            BillingMetadata?
  Subscription               Subscription[]
  admin                      Admin                        @relation(fields: [createdBy], references: [id])
  Payment                    Payment[]
  logs                       Logs[]
  BillingPlan                BillingPlan[]
  Invoice                    Invoice[]
  PaymentMethod              PaymentMethod[]
  issues                     Issue[]
  tenantAdminChoices         TenantAdminChoices?
  domain                     Domain[]
  OrganizationInformation    OrganizationInformation?
  OrganizationDocuments      OrganizationDocuments[]
  OrganizationDiagnosisCodes OrganizationDiagnosisCodes[]
  OrganizationSessionTypes   OrganizationSessionTypes[]
  OrganizationLicenses       OrganizationLicenses[]
  Appointment                Appointment[]
  ServiceCodes               ServiceCodes[]
  RoundingRules              RoundingRules[]
  InsuranceType              InsuranceType[]
  Payer                      Payer[]
}

model TenantStaff {
  id       String  @id @default(uuid())
  fullName String
  email    String  @unique
  stage    String?
  roleId   String
  tenantId String
  dob      String?
  gender   String?
  npi      String?
  address  String?
  city     String?
  state    String?
  zip      String?
  country  String?

  phoneNumber  String   @unique
  active       Boolean  @default(true)
  isDeleted    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  password     String?
  authType     String?
  authQuestion String?
  auth2FADone  Boolean  @default(false)

  role                 Role                   @relation(fields: [roleId], references: [id])
  tenant               Tenant                 @relation(fields: [tenantId], references: [id])
  PipelineItem         PipelineItem[]
  ClientTenant         ClientTenant[]
  TenantStaffLicenses  TenantStaffLicenses[]
  TenantStaffPayroll   TenantStaffPayroll[]
  TenantStaffDocuments TenantStaffDocuments[]
  appointments         Appointment[]          @relation("AppointmentClinicians")
}

model TenantStaffLicenses {
  id            String   @id @default(uuid())
  licenseName   String
  licenseNumber String
  tenantStaffId String
  issueState    String
  expiryDate    DateTime
  isDeleted     Boolean  @default(false)

  tenantStaff TenantStaff @relation(fields: [tenantStaffId], references: [id])
}

model TenantStaffPayroll {
  id              String  @id @default(uuid())
  paymentSchedule String
  ratePerHour     String
  tenantStaffId   String
  minimumHours    String?
  otherPays       Json?
  deductions      Json?
  isDeleted       Boolean @default(false)

  tenantStaff TenantStaff @relation(fields: [tenantStaffId], references: [id])
}

model TenantStaffDocuments {
  id            String   @id @default(uuid())
  documentsUrl  Json
  tenantStaffId String
  isDeleted     Boolean  @default(false)
  createdAt     DateTime @default(now())

  tenantStaff TenantStaff @relation(fields: [tenantStaffId], references: [id])
}

model Client {
  id            String   @id @default(uuid())
  fullName      String
  email         String   @unique
  phoneNumber   String   @unique
  DOB           DateTime
  gender        String
  streetAddress String
  city          String
  state         String
  country       String
  zipCode       String
  isVerified    Boolean  @default(false)
  isDeleted     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  password      String?

  pipelineItems PipelineItem[]
  tenantLinks   ClientTenant[]
  logs          Logs[]
  ClientProgram ClientProgram[]
  ClientTarget  ClientTarget[]
  Appointment   Appointment[]
}

model ClientTenant {
  id        String   @id @default(uuid())
  clientId  String
  tenantId  String
  createdBy String
  dbAccess  Boolean  @default(false)
  active    Boolean  @default(true)
  stage     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenantStaff TenantStaff @relation(fields: [createdBy], references: [id])
  client      Client      @relation(fields: [clientId], references: [id])
  tenant      Tenant      @relation(fields: [tenantId], references: [id])

  @@unique([clientId, tenantId])
}

model Pipeline {
  id                String   @id @default(uuid())
  module            Module
  name              String
  description       String?
  createdByAdminId  String?
  createdByTenantId String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  isActive          Boolean  @default(true)

  pipelineStages  PipelineStage[]
  createdByAdmin  Admin?          @relation(fields: [createdByAdminId], references: [id])
  createdByTenant Tenant?         @relation(fields: [createdByTenantId], references: [id])
}

model PipelineStage {
  id          String   @id @default(uuid())
  pipelineId  String
  tasks       Json
  documents   Json
  name        String
  colourCode  String
  order       Int
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  pipelineItem PipelineItem[]
  pipeline     Pipeline       @relation(fields: [pipelineId], references: [id])
}

model PipelineItem {
  id                  String   @id @default(uuid())
  tenantId            String?
  clientId            String?
  pipelineStageId     String
  assignToAdmin       String?
  assignToTenantStaff String?
  doneTasks           Json?
  sentDocuments       Json?
  isDeleted           Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  client        Client?        @relation(fields: [clientId], references: [id])
  tenant        Tenant?        @relation(fields: [tenantId], references: [id])
  pipelineStage PipelineStage? @relation(fields: [pipelineStageId], references: [id])
  tenantStaff   TenantStaff?   @relation(fields: [assignToTenantStaff], references: [id])
  admin         Admin?         @relation(fields: [assignToAdmin], references: [id])
}

model BillingMetadata {
  id             String         @id @default(uuid())
  tenantId       String         @unique
  paymentMethod  String
  billingAddress String
  paymentHistory Transactions[]
  tenant         Tenant         @relation(fields: [tenantId], references: [id])
}

model Transactions {
  id                String  @id @default(uuid())
  billingMetadataId String?
  status            String

  BillingMetadata BillingMetadata? @relation(fields: [billingMetadataId], references: [id])
  subscription    Subscription?
}

model Subscription {
  id               String             @id @default(uuid())
  tenantId         String
  planId           String
  status           SubscriptionStatus
  startDate        DateTime
  billingCycle     String
  // lastPaymentStatus String
  // amount            Int
  pauseSchedule    DateTime?
  resumeShedule    DateTime?
  autoRenew        Boolean?           @default(true)
  mailNotification Boolean?
  endDate          DateTime
  transactionId    String             @unique
  paymentId        Int                @unique
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  tenant      Tenant       @relation(fields: [tenantId], references: [id])
  transaction Transactions @relation(fields: [transactionId], references: [id])
  payment     Payment      @relation(fields: [paymentId], references: [id])
  plan        BillingPlan  @relation(fields: [planId], references: [id])
  Logs        Logs[]
}

model BillingPlan {
  id                     String   @id @default(uuid())
  planType               PlanType
  name                   String
  colourCode             String
  description            String?
  pricePerMonth          Json
  pricePerYear           Json
  forClient              Int
  extraFeaturesWithPrice Json?
  forStaff               Int
  forStorage             Float
  extraFeaturesEnabled   Boolean  @default(false)
  active                 Boolean  @default(true)
  tenantId               String?
  adminId                String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  features       Feature[]      @relation("PlanFeatures")
  extraFeatures  Feature[]      @relation("ExtraFeatures")
  subscriptions  Subscription[]
  assignedTo     Tenant?        @relation(fields: [tenantId], references: [id])
  accountManager Admin?         @relation(fields: [adminId], references: [id])
  Invoice        Invoice[]
}

model Feature {
  id             String   @id @default(uuid())
  name           String
  description    String?
  featureGroupId String
  active         Boolean  @default(true)
  // applicablePlans Json
  managedBy      String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  plans        BillingPlan[] @relation("PlanFeatures")
  extraPlans   BillingPlan[] @relation("ExtraFeatures")
  featureGroup FeatureGroup? @relation(fields: [featureGroupId], references: [id])
  logs         Logs[]
}

model FeatureGroup {
  id        String   @id @default(uuid())
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  Feature Feature[]
}

model SuperAdminChoices {
  id               String   @id @default(uuid())
  Authenticator2FA Boolean
  securityQuestion Boolean
  setForAll        Boolean
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model TenantAdminChoices {
  id               String   @id @default(uuid())
  tenantId         String   @unique
  Authenticator2FA Boolean
  securityQuestion Boolean
  setForAll        Boolean
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
}

model Payment {
  id              Int      @id @default(autoincrement())
  tenantId        String
  status          String
  amount          Int
  invoiceId       Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  paymentMethodId String

  subscription  Subscription?
  tenant        Tenant?        @relation(fields: [tenantId], references: [id])
  invoice       Invoice?       @relation(fields: [invoiceId], references: [id])
  paymentMethod PaymentMethod? @relation(fields: [paymentMethodId], references: [id])
}

model Logs {
  logId          String   @id @default(uuid())
  tenantId       String?
  clientId       String?
  adminId        String?
  featureId      String?
  module         Module?
  action         String
  reason         String
  details        String?
  ipAddress      String?
  subscriptionId String?
  issueId        String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant       Tenant?       @relation(fields: [tenantId], references: [id])
  client       Client?       @relation(fields: [clientId], references: [id])
  admin        Admin?        @relation(fields: [adminId], references: [id])
  feature      Feature?      @relation(fields: [featureId], references: [id])
  issue        Issue?        @relation(fields: [issueId], references: [id])
  subscription Subscription? @relation(fields: [subscriptionId], references: [id])
}

model Invoice {
  id               Int                     @id @default(autoincrement())
  tenantId         String
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  dueDate          DateTime
  status           InvoiceStatus
  planId           String
  quantity         Int
  total            Int
  billingFrequency incoiceBillingFrequency

  tenant  Tenant?      @relation(fields: [tenantId], references: [id])
  plan    BillingPlan? @relation(fields: [planId], references: [id])
  Payment Payment[]
}

model PaymentMethod {
  id             String   @id @default(uuid())
  cardType       String
  lastFourDigits String
  tenantId       String
  gatewayToken   String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  payment Payment[]
  tenant  Tenant?   @relation(fields: [tenantId], references: [id])
}

model InvoiceManagement {
  id                        String  @id @default(uuid())
  onPlanPurchase            Boolean
  daysBeforeDueDate         Int
  upcomingInvoiceHeader     String
  upcomingInvoiceBody       String
  onDueDate                 Boolean
  dueInvoiceHeader          String
  dueInvoiceBody            String
  markOverDue               Int
  unpaidReminderTimesBefore Int
  attachInvoiceToReminder   Boolean
  reminderEmail             Json
}

model PaymentAndAccountAccess {
  id                       String  @id @default(uuid())
  chargeOnDueDate          Boolean
  chargeLastUsedFirst      Boolean
  chargeAlternative        Boolean
  retryBefore              Int
  retryAfter               Int
  notifyTenant             Boolean
  notificationEmailHeader  String
  notificationEmailBody    String
  cancelAfter              Int
  manualCancel             Boolean
  suspensionAction         String
  errorMessage             String
  emailAfterAttempts       Int
  warningMailHeader        String
  warningMailBody          String
  sendOnSubscriptionCancel Boolean
  cancelMailHeader         String
  cancelMailBody           String
}

model Issue {
  id                    String   @id @default(uuid())
  category              String
  priority              String
  tenantId              String
  adminId               String?
  title                 String
  adminLoggedById       String?
  status                String
  resolutionDeadline    DateTime
  attachments           Json?
  description           String
  resolutionDescription String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  tenant     Tenant @relation(fields: [tenantId], references: [id])
  assignedTo Admin? @relation("AssignedAdmin", fields: [adminId], references: [id])
  loggedBy   Admin? @relation("LoggedByAdmin", fields: [adminLoggedById], references: [id])

  comments IssueComment[]
  Logs     Logs[]
}

model IssueComment {
  id        String   @id @default(uuid())
  issueId   String
  comment   String
  adminId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  issue     Issue @relation(fields: [issueId], references: [id])
  commentBy Admin @relation(fields: [adminId], references: [id])
}

model Domain {
  id          String     @id @default(uuid())
  name        String
  description String
  tenantId    String
  domainType  DomainType
  isDeleted   Boolean    @default(false)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  tenant  Tenant    @relation(fields: [tenantId], references: [id])
  program Program[]
}

model Program {
  id          String   @id @default(uuid())
  name        String
  description String
  domainId    String
  isDeleted   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  domain        Domain          @relation(fields: [domainId], references: [id])
  target        Target[]
  ClientProgram ClientProgram[]
}

model Target {
  id                   String   @id @default(uuid())
  name                 String
  description          String
  programId            String
  isDeleted            Boolean  @default(false)
  sd                   String
  expectedResponse     String
  teachingProcedure    String
  promptingStrategy    Json
  dataCollectionType   String
  baselineDataRequired Boolean
  numberOfTrials       Int?
  numberOfTasks        Int?
  taskSteps            Json?
  masteryMetric        String
  masteryCriteria      Json
  initialStatus        String
  attachment           String
  notes                String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  program      Program        @relation(fields: [programId], references: [id])
  ClientTarget ClientTarget[]
}

model ClientProgram {
  id        String   @id @default(uuid())
  clientId  String
  programId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client  Client  @relation(fields: [clientId], references: [id])
  program Program @relation(fields: [programId], references: [id])

  @@unique([clientId, programId])
}

model ClientTarget {
  id        String   @id @default(uuid())
  clientId  String
  targetId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client                     Client                       @relation(fields: [clientId], references: [id])
  target                     Target                       @relation(fields: [targetId], references: [id])
  ClientTargetDataCollection ClientTargetDataCollection[]
}

model ClientTargetDataCollection {
  id             String   @id @default(uuid())
  clientTargetId String
  data           Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  clientTarget ClientTarget @relation(fields: [clientTargetId], references: [id])
}

model OrganizationInformation {
  id            String @id @default(uuid())
  tenantId      String @unique
  name          String
  email         String
  phoneNumber   String
  website       String
  practiceNPI   String
  streetAddress String
  city          String
  state         String
  country       String
  zipCode       String

  tenant Tenant @relation(fields: [tenantId], references: [id])
}

model OrganizationLicenses {
  id            String   @id @default(uuid())
  tenantId      String
  licenseName   String
  licenseNumber String
  issueState    String
  expiryDate    DateTime
  isDeleted     Boolean  @default(false)

  tenant Tenant @relation(fields: [tenantId], references: [id])
}

model OrganizationDocuments {
  id           String   @id @default(uuid())
  tenantId     String
  documentName String
  documentUrl  String
  uploadedBy   String
  createdAt    DateTime @default(now())
  isDeleted    Boolean  @default(false)

  tenant Tenant @relation(fields: [tenantId], references: [id])
}

model OrganizationDiagnosisCodes {
  id          String  @id @default(uuid())
  tenantId    String
  code        String
  description String
  isActive    Boolean

  tenant Tenant @relation(fields: [tenantId], references: [id])
}

model OrganizationSessionTypes {
  id                String  @id @default(uuid())
  tenantId          String
  name              String
  category          String
  service           Json
  staffRolesAllowed Json
  locationsAllowed  Json
  defaultDuration   Int
  isActive          Boolean
  isBillable        Boolean

  tenant      Tenant        @relation(fields: [tenantId], references: [id])
  Appointment Appointment[]
}

model Appointment {
  id                 String    @id @default(uuid())
  clientId           String
  tenantId           String
  sessionId          String
  service            Json
  date               String
  isRecurring        Boolean
  startTime          String
  endTime            String
  recurrence         Json
  isBillable         Boolean
  serviceLocation    String
  requiresTravel     Boolean
  colourCode         String
  relatedAppointment String?
  isCanceled         Boolean   @default(false)
  reasonForCancel    String?
  rescheduled        Boolean   @default(false)
  rescheduleAccepted Boolean   @default(false)
  rescheduleRejected Boolean   @default(false)
  canceledBy         String?
  cancelTime         DateTime?
  previousDate       String?
  previousStartTime  String?
  previousEndTime    String?

  client      Client                   @relation(fields: [clientId], references: [id])
  tenant      Tenant                   @relation(fields: [tenantId], references: [id])
  session     OrganizationSessionTypes @relation(fields: [sessionId], references: [id])
  relatedTo   Appointment?             @relation("AppointmentRelation", fields: [relatedAppointment], references: [id])
  relatedFrom Appointment[]            @relation("AppointmentRelation")
  clinicians  TenantStaff[]            @relation("AppointmentClinicians")
}

model ServiceCodes {
  id          String  @id @default(uuid())
  tenantId    String
  code        String
  description String
  modifiers   Json
  isDeleted   Boolean @default(false)
  isActive    Boolean @default(true)

  tenant            Tenant              @relation(fields: [tenantId], references: [id])
  PayerServiceCodes PayerServiceCodes[]
}

model RoundingRules {
  id           String  @id @default(uuid())
  tenantId     String
  ruleType     String
  ruleName     String
  description  String
  standardUnit Int?
  roundingRule Json?
  isDeleted    Boolean @default(false)
  isActive     Boolean @default(true)

  tenant            Tenant              @relation(fields: [tenantId], references: [id])
  PayerServiceCodes PayerServiceCodes[]
}

model InsuranceType {
  id          String  @id @default(uuid())
  tenantId    String
  name        String
  description String
  isDeleted   Boolean @default(false)
  isActive    Boolean @default(true)

  tenant Tenant  @relation(fields: [tenantId], references: [id])
  Payer  Payer[]
}

model Payer {
  id              String  @id @default(uuid())
  tenantId        String
  payerName       String
  email           String
  phone           String
  insuranceTypeId String
  tplCode         String
  carrierPayerId  String
  address         String
  city            String
  state           String
  zip             String
  country         String
  serviceCodes    Json
  isDeleted       Boolean @default(false)
  isActive        Boolean @default(true)

  tenant            Tenant              @relation(fields: [tenantId], references: [id])
  insuranceType     InsuranceType       @relation(fields: [insuranceTypeId], references: [id])
  PayerServiceCodes PayerServiceCodes[]
}

model PayerServiceCodes {
  id             String  @id @default(uuid())
  payerId        String
  serviceCodeId  String
  unitCurrency   String
  modifiers      Json
  ratePerUnit    Int
  roundingRuleId String
  billable       Boolean
  isDeleted      Boolean @default(false)
  isActive       Boolean @default(true)

  serviceCode  ServiceCodes  @relation(fields: [serviceCodeId], references: [id])
  roundingRule RoundingRules @relation(fields: [roundingRuleId], references: [id])
  payer        Payer         @relation(fields: [payerId], references: [id])
}
