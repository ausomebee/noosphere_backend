generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Module {
  ADMIN
  TENANT
  CLIENT
}

enum SubscriptionStatus {
  ACTIVE
  INACTIVE
  CANCELLED
}

enum PlanType {
  ENTERPRISE
  STANDARD
}

model Admin {
  id                    String   @id @default(uuid())
  fullName              String
  email                 String   @unique
  phoneNumber           String   @unique
  roleId                String
  superAdmin            Boolean  @default(false)
  active                Boolean  @default(true)
  isDeleted             Boolean  @default(false)
  password              String?
  administratorPassword String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  authType              String?
  authQuestion          String?
  auth2FADone           Boolean  @default(false)

  roles        Role           @relation(fields: [roleId], references: [id])
  pipelines    Pipeline[]
  departments  Department[]
  PipelineItem PipelineItem[]
  Tenant       Tenant[]
  logs         Logs[]
  BillingPlan  BillingPlan[]
}

model Auth {
  id        String   @id @default(uuid())
  userId    String   @unique
  module    Module
  secret    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Department {
  id                String   @id @default(uuid())
  name              String
  module            Module
  createdByAdminId  String?
  createdByTenantId String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  description       String?
  access            Json

  roles           Role[]
  createdByAdmin  Admin?  @relation(fields: [createdByAdminId], references: [id])
  createdByTenant Tenant? @relation(fields: [createdByTenantId], references: [id])
}

model Role {
  id           String   @id @default(uuid())
  name         String
  description  String?
  departmentId String
  access       Json
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  admins      Admin[]
  department  Department    @relation(fields: [departmentId], references: [id])
  TenantStaff TenantStaff[]
}

model Tenant {
  id               String   @id @default(uuid())
  email            String   @unique
  phoneNumber      String   @unique
  active           Boolean  @default(true)
  isDeleted        Boolean  @default(false)
  companyName      String
  contactPerson    String
  companySize      String
  organizationType String
  location         Json
  leadSource       String
  stage            String   @default("UNVERIFIED")
  createdBy        String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  pipelineItems   PipelineItem[]
  clientLinks     ClientTenant[]
  pipelines       Pipeline[]
  departments     Department[]
  TenantStaff     TenantStaff[]
  BillingMetadata BillingMetadata?
  Subscription    Subscription[]
  admin           Admin            @relation(fields: [createdBy], references: [id])
  Payment         Payment?
  logs            Logs[]
  BillingPlan     BillingPlan[]
}

model TenantStaff {
  id          String   @id @default(uuid())
  fullName    String
  email       String   @unique
  stage       String
  roleId      String
  tenantId    String
  phoneNumber String   @unique
  active      Boolean  @default(true)
  isDeleted   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  password    String?

  roles        Role           @relation(fields: [roleId], references: [id])
  tenant       Tenant         @relation(fields: [tenantId], references: [id])
  PipelineItem PipelineItem[]
}

model Client {
  id          String   @id @default(uuid())
  fullName    String
  email       String   @unique
  phoneNumber String   @unique
  DOB         DateTime
  gender      String
  isDeleted   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  password    String?

  pipelineItems PipelineItem[]
  tenantLinks   ClientTenant[]
  logs          Logs[]
}

model ClientTenant {
  id        String   @id @default(uuid())
  clientId  String
  tenantId  String
  dbAccess  Boolean  @default(false)
  active    Boolean  @default(true)
  stage     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id])
  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([clientId, tenantId])
}

model Pipeline {
  id                String   @id @default(uuid())
  module            Module
  name              String
  description       String?
  createdByAdminId  String?
  createdByTenantId String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  isActive          Boolean  @default(true)

  pipelineStages  PipelineStage[]
  createdByAdmin  Admin?          @relation(fields: [createdByAdminId], references: [id])
  createdByTenant Tenant?         @relation(fields: [createdByTenantId], references: [id])
}

model PipelineStage {
  id          String   @id @default(uuid())
  pipelineId  String
  tasks       Json
  documents   Json
  name        String
  colourCode  String
  order       Int
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  pipelineItem PipelineItem[]
  pipeline     Pipeline       @relation(fields: [pipelineId], references: [id])
}

model PipelineItem {
  id                  String   @id @default(uuid())
  tenantId            String?
  clientId            String?
  pipelineStageId     String
  assignToAdmin       String?
  assignToTenantStaff String?
  doneTasks           Json?
  sentDocuments       Json?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  client        Client?        @relation(fields: [clientId], references: [id])
  tenant        Tenant?        @relation(fields: [tenantId], references: [id])
  pipelineStage PipelineStage? @relation(fields: [pipelineStageId], references: [id])
  tenantStaff   TenantStaff?   @relation(fields: [assignToTenantStaff], references: [id])
  admin         Admin?         @relation(fields: [assignToAdmin], references: [id])
}

model BillingMetadata {
  id             String         @id @default(uuid())
  tenantId       String         @unique
  paymentMethod  String
  billingAddress String
  paymentHistory Transactions[]
  tenant         Tenant         @relation(fields: [tenantId], references: [id])
}

model Transactions {
  id                String  @id @default(uuid())
  billingMetadataId String?
  status            String

  BillingMetadata BillingMetadata? @relation(fields: [billingMetadataId], references: [id])
  subscription    Subscription?
}

model Subscription {
  id            String             @id @default(uuid())
  tenantId      String
  planId        String
  status        SubscriptionStatus
  startDate     DateTime
  endDate       DateTime
  transactionId String             @unique

  tenant      Tenant       @relation(fields: [tenantId], references: [id])
  transaction Transactions @relation(fields: [transactionId], references: [id])
  plan        BillingPlan  @relation(fields: [planId], references: [id])
}

model BillingPlan {
  id                     String   @id @default(uuid())
  planType               PlanType
  name                   String
  colourCode             String
  description            String?
  pricePerMonth          Json
  pricePerYear           Json
  forClient              Int
  extraFeaturesWithPrice Json?
  forStaff               Int
  forStorage             Float
  extraFeaturesEnabled   Boolean  @default(false)
  active                 Boolean  @default(true)
  tenantId               String?
  adminId                String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  features       Feature[]      @relation("PlanFeatures")
  extraFeatures  Feature[]      @relation("ExtraFeatures")
  subscriptions  Subscription[]
  assignedTo     Tenant?        @relation(fields: [tenantId], references: [id])
  accountManager Admin?         @relation(fields: [adminId], references: [id])
}

model Feature {
  id             String   @id @default(uuid())
  name           String
  description    String?
  featureGroupId String
  active         Boolean  @default(true)
  // applicablePlans Json
  managedBy      String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  plans        BillingPlan[] @relation("PlanFeatures")
  extraPlans   BillingPlan[] @relation("ExtraFeatures")
  featureGroup FeatureGroup? @relation(fields: [featureGroupId], references: [id])
  logs         Logs[]
}

model FeatureGroup {
  id        String   @id @default(uuid())
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  Feature Feature[]
}

model SuperAdminChoices {
  id               String   @id @default(uuid())
  Authenticator2FA Boolean
  securityQuestion Boolean
  setForAll        Boolean
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Payment {
  id          String   @id @default(uuid())
  paymentLink String
  tenantId    String   @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant? @relation(fields: [tenantId], references: [id])
}

model Logs {
  logId     String   @id @default(uuid())
  tenantId  String?
  clientId  String?
  adminId   String?
  featureId String?
  module    Module
  action    String
  details   String?
  ipAddress String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant  Tenant?  @relation(fields: [tenantId], references: [id])
  client  Client?  @relation(fields: [clientId], references: [id])
  admin   Admin?   @relation(fields: [adminId], references: [id])
  feature Feature? @relation(fields: [featureId], references: [id])
}
